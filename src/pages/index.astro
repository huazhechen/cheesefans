---
const apps = [
  {
    name: "魔方模拟器",
    href: "https://cuber.cheesefans.com",
    type: "cube",
  },
  {
    name: "在线文本乐谱编辑器",
    href: "https://score.cheesefans.com",
    type: "score",
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cheesefans tools" />
    <meta name="theme-color" content="#14171c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>芝士分子</title>
  </head>
  <body>
    <main>
      <header>
        <a class="brand" href="/">芝士分子</a>
      </header>

      <section class="apps" aria-label="工具预览">
        {
          apps.map((app) => (
            <article class={`app ${app.type}`}>
              <div class="app-bar">
                <h1>{app.name}</h1>
              </div>
              <div class="preview">
                <iframe src={app.href} title={`${app.name} 预览`} loading="lazy" tabindex="-1" />
              </div>
              <a class="preview-link" href={app.href} aria-label={`打开${app.name}`}><span aria-hidden="true">打开工具 &#8599;</span></a>
            </article>
          ))
        }
      </section>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #e9edf3;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    background: #14171c;
  }

  main { width: min(1440px, calc(100% - 40px)); margin: 0 auto; padding: 22px 0 40px; }
  header { display: flex; align-items: center; min-height: 64px; }
  .brand { color: #ffffff; font-size: 34px; font-weight: 750; letter-spacing: 0; text-decoration: none; }

  .apps { display: grid; grid-template-columns: repeat(auto-fit, min(40vw, calc((100% - 18px) / 2))); grid-auto-rows: 80vh; justify-content: center; gap: 18px; margin-top: 30px; }
  .app { position: relative; display: grid; grid-template-rows: 52px minmax(0, 1fr); overflow: hidden; border: 1px solid #323943; border-radius: 8px; background: #ffffff; box-shadow: 0 18px 50px rgba(0, 0, 0, 0.22); }
  .app-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 16px; color: #e9edf3; background: #1d232c; }
  .score .app-bar { color: #263033; background: #f2f3ee; }
  .app h1 { margin: 0; font-size: 15px; font-weight: 650; letter-spacing: 0; }
  .preview { position: relative; min-height: 0; }
  iframe { display: block; width: 100%; height: 100%; border: 0; background: #ffffff; pointer-events: none; }
  .preview-link { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; color: transparent; background: transparent; text-decoration: none; transition: background-color 150ms ease; }
  .preview-link span { padding: 10px 14px; border: 1px solid transparent; border-radius: 6px; color: transparent; background: transparent; font-size: 14px; font-weight: 700; transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease; }
  .preview-link:hover, .preview-link:focus-visible { background: rgba(38, 43, 50, 0.52); }.preview-link:hover span, .preview-link:focus-visible span { border-color: rgba(255, 255, 255, 0.32); color: #ffffff; background: rgba(20, 23, 28, 0.72); }.preview-link:focus-visible { outline: 2px solid #3b8cff; outline-offset: -3px; }

  @media (orientation: portrait) { .apps { grid-template-columns: repeat(auto-fit, 80vw); grid-auto-rows: 80vh; } }
  @media (hover: none) { .preview-link { background: rgba(38, 43, 50, 0.52); }.preview-link span { border-color: rgba(255, 255, 255, 0.32); color: #ffffff; background: rgba(20, 23, 28, 0.72); } }
  @media (max-width: 500px) { main { width: 100%; padding-top: 0; }.brand, header { padding-left: 16px; }.brand { font-size: 28px; }.apps { gap: 12px; margin-top: 12px; }.app { grid-template-rows: 44px minmax(0, 1fr); border-radius: 5px; }.app-bar { padding: 0 12px; }.app h1 { font-size: 13px; }.preview-link span { padding: 8px 10px; font-size: 12px; } }
</style>
