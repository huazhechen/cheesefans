---
const apps = [
  {
    name: "魔方模拟器",
    description: "转动、练习与探索",
    href: "https://cuber.cheesefans.com",
    type: "cube",
  },
  {
    name: "在线文本乐谱编辑器",
    description: "写下旋律和节拍",
    href: "https://score.cheesefans.com",
    type: "score",
  },
  {
    name: "即将推出 01",
    description: "新的工具正在开发中",
    type: "coming-soon",
  },
  {
    name: "即将推出 02",
    description: "新的工具正在开发中",
    type: "coming-soon",
  },
  {
    name: "即将推出 03",
    description: "新的工具正在开发中",
    type: "coming-soon",
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Cheesefans tools" />
    <meta name="theme-color" content="#f8bf25" />
    <link rel="icon" href="/cheese-icon-static.png" type="image/png" />
    <title>芝士分子</title>
  </head>
  <body>
    <main>
      <header>
        <a class="brand" href="/" aria-label="芝士分子首页">
          <span class="brand-mark"><img src="/cheese-icon-static.png" alt="" /></span>
          <span>芝士分子</span>
        </a>
        <span class="brand-note">Cheesefans</span>
      </header>

      <section class="intro" aria-labelledby="tools-title">
        <p class="eyebrow">A little collection of useful things</p>
        <h1 id="tools-title">工具，切一块正好。</h1>
      </section>

      <section class="apps" aria-label="工具预览">
        {
          apps.map((app) => (
            <article class={`app ${app.type}`}>
              <div class="app-bar">
                <div class="app-title">
                  <img class="mini-cheese" src="/cheese-icon-static.png" alt="" />
                  <div>
                    <h2>{app.name}</h2>
                    <p>{app.description}</p>
                  </div>
                </div>
              </div>
              {
                app.href ? (
                  <>
                    <div class="preview">
                      <iframe src={app.href} title={`${app.name} 预览`} loading="lazy" tabindex="-1" />
                    </div>
                    <a class="preview-link" href={app.href} aria-label={`打开${app.name}`}><span>打开工具 <b aria-hidden="true">↗</b></span></a>
                  </>
                ) : (
                  <div class="coming-soon-preview" aria-label="开发中">
                    <span>开发中</span>
                  </div>
                )
              }
            </article>
          ))
        }
      </section>

    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }

  :global(body) {
    min-width: 320px;
    min-height: 100vh;
    margin: 0;
    color: #2c271f;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
    background: #fffaf0;
  }

  main { width: min(1440px, 80%); margin: 0 auto; padding: 22px 0 32px; }
  header { display: flex; align-items: center; min-height: 58px; gap: 14px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: #332b1d; font-size: 25px; font-weight: 800; letter-spacing: 0; text-decoration: none; }
  .brand-mark { display: grid; width: 43px; height: 43px; place-items: center; padding: 2px; border: 1px solid #e5bb4c; border-radius: 7px; background: #fff3c6; box-shadow: 2px 2px 0 #e7c55e; }
  .brand-mark img { width: 100%; height: 100%; }
  .brand-note { color: #9b8150; font-size: 13px; font-weight: 650; letter-spacing: .08em; text-transform: uppercase; }

  .intro { margin: 48px 0 25px; }
  .eyebrow { margin: 0 0 7px; color: #947947; font-size: 12px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  .intro h1 { max-width: 700px; margin: 0; color: #312817; font-size: clamp(30px, 4vw, 50px); line-height: 1.1; letter-spacing: 0; }

  .apps { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); grid-auto-rows: auto; gap: 18px; }
  .app { position: relative; display: grid; width: min(100%, 80vw, 45vh); max-height: 60vh; justify-self: center; aspect-ratio: 3 / 4; grid-template-rows: 66px minmax(0, 1fr); overflow: hidden; border: 1px solid #e7d7b7; border-radius: 8px; background: #fff; box-shadow: 0 14px 30px rgba(103, 75, 20, .12); transition: transform 180ms ease, box-shadow 180ms ease; }
  .app:hover { transform: translateY(-3px); box-shadow: 0 20px 36px rgba(103, 75, 20, .17); }
  .app-bar { display: flex; align-items: center; gap: 16px; padding: 0 18px; color: #3a2c11; background: #ffdd69; border-bottom: 1px solid #e5ba41; }
  .app-title { display: flex; min-width: 0; align-items: center; gap: 11px; }
  .mini-cheese { width: 30px; height: 30px; flex: 0 0 auto; object-fit: contain; }
  .app h2, .app p { margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .app h2 { font-size: 15px; font-weight: 800; letter-spacing: 0; }
  .app p { margin-top: 2px; color: rgba(58, 44, 17, .66); font-size: 12px; font-weight: 550; }
  .preview { position: relative; min-height: 0; background: #fff; }
  .coming-soon-preview { display: grid; min-height: 0; place-items: center; color: #9b8150; background: repeating-linear-gradient(-45deg, #fffaf0 0 12px, #fff4da 12px 24px); font-size: 13px; font-weight: 750; letter-spacing: .08em; text-transform: uppercase; }
  iframe { display: block; width: 100%; height: 100%; border: 0; background: #fff; pointer-events: none; }
  .preview-link { position: absolute; inset: 0; z-index: 1; display: grid; place-items: center; color: transparent; background: transparent; text-decoration: none; transition: background-color 150ms ease; }
  .preview-link span { padding: 10px 14px; border: 1px solid transparent; border-radius: 6px; color: transparent; background: transparent; font-size: 14px; font-weight: 750; transition: color 150ms ease, background-color 150ms ease, border-color 150ms ease; }
  .preview-link b { font-size: 17px; }
  .preview-link:hover, .preview-link:focus-visible { background: rgba(61, 45, 13, .46); }
  .preview-link:hover span, .preview-link:focus-visible span { border-color: #f5cc52; color: #fffdf7; background: #302817; }
  .preview-link:focus-visible { outline: 3px solid #c48800; outline-offset: -3px; }

  @media (orientation: portrait) { .apps { grid-template-columns: 1fr; } }
  @media (hover: none) { .preview-link { background: rgba(61, 45, 13, .42); }.preview-link span { border-color: #f5cc52; color: #fffdf7; background: #302817; } }
  @media (max-width: 500px) { main { padding-top: 10px; }.brand { font-size: 22px; }.brand-note { display: none; }.intro { margin: 33px 0 21px; }.intro h1 { font-size: 31px; }.apps { grid-template-columns: 1fr; gap: 13px; grid-auto-rows: auto; }.app { border-radius: 6px; grid-template-rows: 60px minmax(0, 1fr); }.app-bar { padding: 0 14px; }.app h2 { font-size: 14px; } }
</style>
